/*
 * =============================================================================
 * nextflow.config — CaMi
 * Cancer–Microbiome interaction, from host whole-genome sequencing
 * -----------------------------------------------------------------------------
 * This file holds the PARAMETERS and the PROFILES. Nothing site-specific is in
 * it. Execution settings are split out:
 *
 *     conf/base.config        resources for each process
 *     conf/containers.config  which image each process runs in
 *     conf/conda.config       the same software without a container engine
 *     conf/modules.config     where each process publishes its results
 *     conf/slurm.config       the generic Slurm executor
 *     conf/site/*.config      one file per cluster; none is loaded by default
 *
 * READ docs/methods.md BEFORE YOU CHANGE A THRESHOLD. Three defaults here were
 * wrong when the pipeline was inherited, and each one changed the bacterial
 * count by more than a factor of 10.
 * =============================================================================
 */

params {
    // --- layout ---------------------------------------------------------------
    // The CODE is this repository (projectDir). The DATA lives wherever
    // --dataRoot points, and is never committed.
    //
    // The default puts the data one level above the repository, which is the
    // layout the original study used. Anyone else should set it explicitly:
    //     nextflow run alihkz94/CaMi --dataRoot /path/to/cohort ...
    //
    // projectDir.parent, NOT "${projectDir}/..": both name the same directory,
    // but the second is a different STRING, and -resume keys on the path. Two
    // spellings of one path would repeat finished work.
    // `file()` is not available in the Nextflow 26 config parser; projectDir is
    // already a Path, so .parent is both correct and normalised.
    dataRoot    = "${projectDir.parent}"
    projectRoot = "${params.dataRoot}"

    // --- where the reads come from --------------------------------------------
    // THREE ROUTES, and only the third needs a download. See lib/helpers.nf and
    // docs/usage.md.
    //
    //   --input samples.csv    a samplesheet: sample,fastq_1,fastq_2 and, when
    //                          you want --step STATS, individual,tissue,
    //                          disease_status,dna_prep
    //   --input /path/to/dir   a directory of paired FASTQ, matched by file name
    //   (unset)                the ENA manifests below — the route the cockle
    //                          study uses, and the default so that study is
    //                          unaffected
    //
    // Reads already on disk need routes 1 or 2. Nothing downloads, no manifest is
    // built, and scripts/download/ is never opened.
    input       = null
    // 'bruzos' reads the study's own sample-code grammar (EPCE18_851H -> individual
    // EPCE18_851, tissue H). 'none' treats a sample name as a name and nothing
    // more. Unset lets the aggregation decide: the grammar on the ENA route,
    // 'none' everywhere else, so another cohort's names are never parsed as
    // tissue codes by accident.
    sample_code_scheme = null

    fastq_dir   = "${params.projectRoot}/fastq"        // raw archive, ACCESSION-named
    refdir      = "${params.projectRoot}/reference"
    outdir      = "${params.projectRoot}/results"
    tmpdir      = "${params.projectRoot}/tmp"
    sample_map  = "${params.projectRoot}/manifests/sample_name_map.csv"
    bam_manifest= "${params.projectRoot}/manifests/skipped_bam_only.tsv"
    bamdir      = "${params.projectRoot}/fastq_from_bam"

    // --- Kraken 2 -------------------------------------------------------------
    // CALIBRATED 2026-08-14/15 on ERR10680552, a run from the pilot study.
    //
    // The inherited pipeline used --confidence 0.1, but the published pilot
    // numbers were produced at --confidence 0. On identical reads:
    //
    //   database      conf   classified  bacteria  human   (pilot: 1685/211/1393)
    //   standard-16   0.1            81         1     61   <- the inherited setting
    //   standard-16   0            1682       210   1394   <- reproduces the pilot
    //   PlusPF        0.1          2138         8   1493
    //   PlusPF        0.05         3518        55   2863
    //   PlusPF        0            7597      1470   5500
    //
    // 2,000,000 fragments of PURE COCKLE DNA were then classified, where every
    // bacterial call is false by construction. That gives the noise floor:
    //
    //   setting          real reads   host-only floor   signal / noise
    //   standard-16 c0     0.0529%        0.0101%          5.2x   <- best
    //   PlusPF      c0     0.3700%        0.1297%          2.9x
    //   PlusPF      c0.05  0.0138%        0.0668%          0.21x  below the floor
    //   PlusPF      c0.1   0.0020%        0.0052%          0.38x  below the floor
    //   standard-16 c0.1   0.0003%        0.0009%          0.33x  below the floor
    //
    // Every setting with confidence >= 0.05 reports FEWER bacteria than pure host
    // DNA produces by itself. Those settings measure noise. Do not use them.
    //
    //   sensitive alternative (more real signal, but a worse ratio):
    //     --kraken_db /path/to/PlusPF_20250402 --kraken_mem_gb 130 --kraken_forks 4
    //
    // The database is NOT bundled and NOT downloaded by the pipeline: it is 16 GB
    // for Standard-16 and 187 GB for Kaiju nr_euk. docs/usage.md says where to get
    // them. Point these at wherever your site keeps them.
    kraken_db         = "${params.projectRoot}/kraken2_db/standard_16gb_20250402"
    kraken_confidence = 0
    bracken_threshold = 10

    // Kraken 2 resources follow the DATABASE, so they must move with it.
    kraken_mem_gb = 32
    kraken_forks  = 8

    // --- Kaiju (protein level) ------------------------------------------------
    // On the same reads Kaiju found 3,249 bacterial pairs where Kraken 2 found
    // 210 — nucleotide k-mers miss marine organisms that have no close relative
    // in any database. It is on by default because that difference is the point.
    //
    // Turn it off (--run_kaiju false) if the machine cannot spare the memory:
    // the index needs about 187 GB of RAM for EACH concurrent task, because Kaiju
    // loads it instead of memory-mapping it.
    run_kaiju    = true
    kaiju_db     = null    // e.g. /db/Kaiju/kaiju_db_nr_euk.fmi
    kaiju_nodes  = null    // e.g. /db/Kaiju/nodes.dmp
    kaiju_names  = null    // e.g. /db/Kaiju/names.dmp
    // MEASURED: peak 193.7 GB, so 220 GB left only a 13% margin. 240 GB is the
    // base and each retry adds 30 GB (conf/base.config).
    //
    // Throughput at 3 forks: the index load is about 3 minutes and is fixed, and
    // classification runs at roughly 265,000 reads/minute with 16 threads. A full
    // run leaves about 1 million pairs per sample after host removal, so expect
    // ~10 minutes per sample => 498 / 3 x 10 min is about 28 hours.
    kaiju_mem_gb = 240
    kaiju_forks  = 3

    // --- host and human removal -----------------------------------------------
    // A read is host when it aligns over at least host_min_cov of its length at no
    // more than host_max_div divergence. See bin/keep_nonhost.sh for the full
    // history — the rule was wrong twice before this version.
    //
    // MAPQ is deliberately NOT part of the rule (host_min_mapq = 0 turns it off).
    // MAPQ < 20 means the aligner cannot choose between equally good copies — a
    // REPEAT — not that the read is foreign. Requiring MAPQ >= 20 called 120,559
    // of 794,668 cockle mates "microbial"; classifying those directly returned
    // 99.33% unclassified (cockle) and 0.61% human.
    host_min_cov  = 0.50
    host_max_div  = 0.10
    host_min_mapq = 0

    host_prefix = "cockle_V1.2.fa"                     // bwa-mem2 index prefix
    human_idx   = "${params.refdir}/GRCh38.primary.mmi"
    // An optional extra minimap2 index built alongside the human one. Used by the
    // validation scripts, not by the profiling chain, so it is null by default.
    vibrio_fa   = null

    // The host genome. CaMi is written around Cerastoderma edule, but nothing in
    // the profiling chain is specific to it: point these at any host assembly and
    // the same contrast works, as long as you re-run the calibration in
    // scripts/calibration/ for that host. docs/methods.md explains why that
    // re-run is not optional.
    cockle_url  = "https://ftp.ncbi.nlm.nih.gov/genomes/all/GCA/947/846/245/GCA_947846245.1_V1.2/GCA_947846245.1_V1.2_genomic.fna.gz"
    human_url   = "https://ftp.ensembl.org/pub/release-110/fasta/homo_sapiens/dna/Homo_sapiens.GRCh38.dna.primary_assembly.fa.gz"

    // --- downstream statistics (--step STATS) ---------------------------------
    // Runs AFTER profiling and reads only what PROFILE wrote, so it is safe to
    // run while PROFILE is still going and safe to re-run as often as needed.
    //
    // stats_python: null means "use the python3 on PATH", which is what the
    // container and the conda profile both provide, and is the right answer
    // almost everywhere. Set it only to point at a hand-built venv — see
    // conf/site/mpi_bremen.config for the one case that needed it.
    stats_python = null

    // Pair tiers (see bin/build_pairs.py):
    //   1 both native, host = foot        <- cleanest contrast in this cohort
    //   2 both native, host = other tissue
    //   3 both WGA
    //   4 prep MISMATCHED  <- disease confounded with library prep; excluded
    // Default 2 keeps tiers 1-2. Measured on the full 563: tier1 n=9, tier2 n=8.
    // n matters more than purity here — see the detectability ceiling that
    // paired_test.py prints, because 2/2^n is a hard floor on any p-value.
    stats_max_tier       = 2
    stats_min_prevalence = 0.5   // taxon must be non-zero in this share of samples
    stats_pseudocount    = 0.5   // added AFTER prevalence filtering, before CLR
    stats_exact_max_n    = 20    // enumerate all 2^n sign vectors up to this n
    stats_n_perm         = 200000 // seeded Monte Carlo above that n
    stats_min_depth      = 0     // drop samples below this many non-host pairs

    // The false-positive floor, as a fraction of a sample's own non-host pairs.
    // MEASURED, not chosen: 2,000,000 fragments of pure host DNA were classified,
    // where every bacterial call is false by construction, and 0.0101 % of them
    // were called bacterial. A taxon that never exceeds that share in any sample
    // is indistinguishable from what host DNA alone produces. See docs/methods.md.
    stats_fp_floor       = 0.000101

    // Permutations for an UNPAIRED comparison. This is a budget, not a bound.
    //
    // The paired test has a real floor: with n pairs there are 2^n sign vectors,
    // so no p below 2/2^n exists however long it runs. An unpaired test has no
    // such floor — the enumeration space is combinatorial and never exhausted —
    // so the smallest reachable p is 1/(B+1), decided here. A million keeps that
    // at ~1e-6, far below any realistic FDR threshold, so the p-value resolution
    // is never the binding constraint on a result. Small groups still limit
    // POWER; that is a different thing, and the report says which one applies.
    stats_n_perm_unpaired = 1000000

    // --- selection ------------------------------------------------------------
    step          = 'all'  // REFERENCE | FETCH_BAM | PROFILE | STATS | all
    samples       = null   // null = all; else "CODE1,CODE2" or a file, one per line
    require_md5ok = true   // only process runs with a verified <ACC>.md5.ok marker
    // TRUE, and the large FASTQ publish as HARD LINKS (conf/modules.config), so
    // every stage's output sits in its own numbered folder at no disk cost.
    publish_intermediates = true

    // --- analysis -------------------------------------------------------------
    // subsample is for TESTS ONLY. At 400,000 pairs a sample shows no microbial
    // signal above the noise. It also costs a full decompression pass to count the
    // reads, which takes 11 minutes on a 12 GB file. Production uses 0.
    subsample = 0
    seed      = 11
    readlen   = 150
    min_microbial_ok = 100

    // --- site behaviour -------------------------------------------------------
    // Both default to "portable". A site profile turns them on; see
    // conf/site/mpi_bremen.config, which is a worked example of a cluster whose
    // data sits on one node's local disk.
    cluster_node    = null   // pin every task to this node (node-local storage only)
    enforce_scratch = false  // refuse to launch unless dataRoot is under /scratch
    conda_bin       = null   // prepend this directory to PATH inside every task
}

// The work directory follows the DATA, not the code. A repository checked out on
// a home directory must not put 4 TB of intermediates there.
workDir = "${params.dataRoot}/work"
cleanup = false          // never auto-delete work/: -resume depends on it

includeConfig 'conf/base.config'
includeConfig 'conf/containers.config'
includeConfig 'conf/modules.config'

profiles {

    /*
     * standard — one machine, no scheduler, no container engine.
     * Deliberately does nothing else: a bare `nextflow run` should not silently
     * pick up someone else's cluster settings. Combine it with what you need:
     *     -profile singularity          a workstation with Singularity
     *     -profile singularity,slurm    a cluster
     */
    standard {
        process.executor = 'local'
    }

    // --- executors ------------------------------------------------------------
    slurm      { includeConfig 'conf/slurm.config' }
    sge        { process.executor = 'sge'    ; process.penv = 'smp' }
    lsf        { process.executor = 'lsf'                           }
    local      { process.executor = 'local'                         }

    // --- software provisioning ------------------------------------------------
    // Exactly one of these. singularity is the recommended one for published work.
    singularity {
        singularity.enabled    = true
        singularity.autoMounts = true
        // Images are converted to .sif once and reused. Without a shared cacheDir
        // every concurrent task on a fresh cluster converts the same image at the
        // same moment, which is slow and occasionally corrupts the cache.
        singularity.cacheDir   = System.getenv('NXF_SINGULARITY_CACHEDIR') ?: "${params.dataRoot}/singularity"
        docker.enabled = false
        podman.enabled = false
        conda.enabled  = false
    }
    apptainer {
        apptainer.enabled    = true
        apptainer.autoMounts = true
        apptainer.cacheDir   = System.getenv('NXF_APPTAINER_CACHEDIR') ?: "${params.dataRoot}/apptainer"
        docker.enabled = false
        podman.enabled = false
        conda.enabled  = false
    }
    docker {
        docker.enabled = true
        // Run as the invoking user, otherwise every published file is owned by
        // root and the next non-root run cannot overwrite it.
        // The bind mounts are NOT here: conf/containers.config adds them per task,
        // where the database paths are finally resolved.
        docker.runOptions = '-u $(id -u):$(id -g)'
        singularity.enabled = false
        podman.enabled      = false
        conda.enabled       = false
    }
    podman {
        podman.enabled     = true
        docker.enabled      = false
        singularity.enabled = false
        conda.enabled       = false
    }
    conda {
        includeConfig 'conf/conda.config'
        docker.enabled      = false
        singularity.enabled = false
        podman.enabled      = false
    }

    // --- sites ----------------------------------------------------------------
    // One file per cluster. Add yours here and send a pull request; a site file
    // may set paths, an executor and resources, and nothing else.
    mpi_bremen { includeConfig 'conf/site/mpi_bremen.config' }

    // --- testing --------------------------------------------------------------
    test       { includeConfig 'conf/test.config' }
}

report   { enabled = true; file = "${params.outdir}/pipeline_info/report.html";   overwrite = true }
timeline { enabled = true; file = "${params.outdir}/pipeline_info/timeline.html"; overwrite = true }
dag      { enabled = true; file = "${params.outdir}/pipeline_info/dag.html";      overwrite = true }
trace    { enabled = true; file = "${params.outdir}/pipeline_info/trace.txt";     overwrite = true
           fields = 'task_id,name,tag,status,exit,attempt,realtime,%cpu,peak_rss,read_bytes,write_bytes' }

manifest {
    name            = 'CaMi'
    author          = 'Ali Hakimzadeh'
    homePage        = 'https://github.com/alihkz94/CaMi'
    description     = 'CaMi — Cancer–Microbiome interaction: recovers the incidental microbial fraction from host whole-genome sequencing and tests it against cancer status'
    mainScript      = 'main.nf'
    nextflowVersion = '>=24.04.0'
    version         = '1.0.0'
    doi             = ''
}
