/*
 * =============================================================================
 * conf/test.config — a small, fast run for checking that the plumbing works
 * -----------------------------------------------------------------------------
 *     nextflow run . -profile test,singularity --dataRoot /path/to/small/cohort
 *
 * WHAT THIS PROFILE IS FOR
 *   Confirming that the images pull, the databases are visible inside them, the
 *   channels connect and the tables come out with the right columns. It runs in
 *   minutes on a laptop-sized machine.
 *
 * WHAT IT IS NOT FOR
 *   Any biological conclusion. subsample = 200,000 pairs is roughly half of what
 *   the calibration showed is needed before a microbial signal clears the noise
 *   floor, and that is on purpose — a test profile that looked like it produced
 *   real abundances would eventually be mistaken for one. Expect near-empty
 *   Bracken tables and let the QC gate flag them.
 *
 * NO TEST DATA IS BUNDLED. The inputs are 55-65 GB BAM files and a 16 GB Kraken
 * database; a repository that carried a usable slice of them would not be a
 * repository. Point --dataRoot at a directory holding two or three samples laid
 * out as docs/usage.md describes.
 * =============================================================================
 */

params {
    subsample     = 200000
    run_kaiju     = false     // the nr_euk index alone is 187 GB
    kraken_forks  = 1
    kraken_mem_gb = 20
    // A handful of samples cannot support the paired design, and build_pairs.py
    // would correctly refuse. Keep every pair it can find.
    stats_max_tier = 4
    publish_intermediates = false
}

process {
    executor      = 'local'
    cpus          = 2
    memory        = 6.GB
    time          = '2h'
    // In a test, a task that fails must say so. The production setting drops the
    // failing sample and carries on, which is right for 563 samples and wrong
    // for three.
    errorStrategy = 'terminate'
    maxRetries    = 0

    withName: 'BUILD_HOST_INDEX' { cpus = 2; memory = 12.GB }
    withName: 'BUILD_MM2_INDEX'  { cpus = 2; memory = 12.GB }
    withName: 'KRAKEN2_BRACKEN'  { cpus = 2; memory = 20.GB; maxForks = 1 }
}
