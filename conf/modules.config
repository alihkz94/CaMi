/*
 * conf/modules.config — where each process publishes its results
 * -----------------------------------------------------------------------------
 * All publishDir rules live here, not in the module files. This is the nf-core
 * convention: the modules stay portable, and the whole output layout can be read
 * in one place.
 *
 * THE LAYOUT IS STEP-MAJOR, NOT SAMPLE-MAJOR
 *   results/01_trimmed/<sample>.fastp.json
 *   results/05_kraken2/<sample>.kraken2.report
 *
 * Every output file therefore MUST start with the sample code. In a step-major
 * layout, a bare name such as `fastp.log` from 498 samples would land on the same
 * path 498 times, and each sample would overwrite the one before it.
 *
 * ON `.toString().toBoolean()` BELOW: a boolean param given on the command line
 * arrives as a STRING, and every non-empty string is true in Groovy — so
 * `--publish_intermediates false` would publish anyway, which here means hard
 * links to several terabytes of intermediate FASTQ. lib/helpers.nf has the full
 * explanation; a config file cannot call that helper, so it spells it out.
 */

process {

    withName: FETCH_GENOME {
        publishDir = [ path: { params.refdir }, mode: 'copy' ]
    }
    withName: BUILD_HOST_INDEX {
        publishDir = [ path: { params.refdir }, mode: 'copy' ]
    }
    withName: BUILD_MM2_INDEX {
        publishDir = [ path: { params.refdir }, mode: 'copy' ]
    }
    withName: FETCH_UNMAPPED_BAM {
        publishDir = [ path: { params.bamdir }, mode: 'copy' ]
    }

    // --- 01: trimming ---------------------------------------------------------
    // The trimmed FASTQ is nearly as large as the raw input. To publish it for 498
    // samples costs about 12 TB of copies, and the next process reads it from the
    // work directory anyway. Use --publish_intermediates to inspect one sample.
    withName: SUBSAMPLE_TRIM {
        publishDir = [
            [ path: { "${params.outdir}/01_trimmed" }, mode: 'copy', pattern: "*.{json,html,log}" ],
            // mode 'link' = HARD link, not a copy. work/ and results/ are on one
            // filesystem, so this costs no disk. A copy would be ~2.5 GB x 2 mates
            // x 498 samples = ~2.5 TB for this stage alone. The data also survives
            // a later work/ cleanup, because a hard link is a real name for the
            // file, not a shortcut that can dangle.
            [ path: { "${params.outdir}/01_trimmed" }, mode: 'link', pattern: "*.trim_*.fastq.gz",
              enabled: params.publish_intermediates.toString().toBoolean() ]
        ]
    }

    // --- 02: cockle removal ---------------------------------------------------
    withName: HOST_REMOVAL {
        publishDir = [
            [ path: { "${params.outdir}/02_host_removed" }, mode: 'copy', pattern: "*.log" ],
            [ path: { "${params.outdir}/02_host_removed" }, mode: 'link', pattern: "*.nohost_*.fastq.gz",
              enabled: params.publish_intermediates.toString().toBoolean() ]
        ]
    }

    // --- 03: human removal ----------------------------------------------------
    withName: HUMAN_REMOVAL {
        publishDir = [
            [ path: { "${params.outdir}/03_human_removed" }, mode: 'copy', pattern: "*.log" ],
            [ path: { "${params.outdir}/03_human_removed" }, mode: 'link', pattern: "*.nonhost_predup_*.fastq.gz",
              enabled: params.publish_intermediates.toString().toBoolean() ]
        ]
    }

    // --- 04: the microbial read set — ALWAYS published ------------------------
    withName: DEDUP {
        publishDir = [ path: { "${params.outdir}/04_dedup" }, mode: 'copy' ]
    }

    // --- 05 / 06: Kraken 2 and Bracken ----------------------------------------
    withName: KRAKEN2_BRACKEN {
        publishDir = [
            [ path: { "${params.outdir}/05_kraken2" }, mode: 'copy', pattern: "*.kraken2.*" ],
            [ path: { "${params.outdir}/06_bracken" }, mode: 'copy', pattern: "*.bracken.*" ]
        ]
    }

    // --- 07: Kaiju, protein level ---------------------------------------------
    // The per-read kaiju.out is large and nothing downstream reads it. It stays
    // compressed in the work directory and is not published.
    withName: KAIJU {
        publishDir = [ path: { "${params.outdir}/07_kaiju" }, mode: 'copy', pattern: "*.{tsv,log}" ]
    }

    // --- 08: the tables that combine every sample -----------------------------
    withName: AGGREGATE_QC {
        publishDir = [ path: { "${params.outdir}/08_summary" }, mode: 'copy' ]
    }

    // --- 09/10/11: downstream statistics (--step STATS) -----------------------
    // 'copy', not 'link': these are the analysis outputs that get read, plotted
    // and sent to people. They must survive a `nextflow clean` of work/.
    // saveAs flattens the leading task subdirectory. The scripts write into
    // tables/ , pairs/ and paired/ inside the task, and publishDir preserves that
    // relative path by default — which would nest the results as
    // 09_tables/tables/... . Publishing the basename keeps the numbered folders
    // flat. NOTE: file() is NOT available in the Nextflow 26 config parser (the
    // same trap as dataRoot in nextflow.config), so this is plain string work.
    withName: AGGREGATE_COUNTS {
        publishDir = [ path: { "${params.outdir}/09_tables" }, mode: 'copy',
                       saveAs: { f -> f.tokenize('/').last() } ]
    }
    withName: BUILD_PAIRS {
        publishDir = [ path: { "${params.outdir}/10_pairs" }, mode: 'copy',
                       saveAs: { f -> f.tokenize('/').last() } ]
    }
    withName: PAIRED_TEST {
        publishDir = [ path: { "${params.outdir}/11_paired_test" }, mode: 'copy',
                       saveAs: { f -> f.tokenize('/').last() } ]
    }
}
