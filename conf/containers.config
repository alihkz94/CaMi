/*
 * =============================================================================
 * conf/containers.config — which image each process runs in, and what it can see
 * -----------------------------------------------------------------------------
 * FIVE images cover the whole pipeline. They are grouped by what has to share a
 * process substrate, not by tool:
 *
 *   cami-fetch      aria2c, curl, samtools, bgzip, python   FETCH_*
 *   cami-qc         fastp, seqkit, pigz, python             SUBSAMPLE_TRIM, DEDUP, AGGREGATE_QC
 *   cami-align      bwa-mem2, minimap2, samtools, gawk      BUILD_*_INDEX, HOST/HUMAN_REMOVAL
 *   cami-classify   kraken2, bracken, kaiju                 KRAKEN2_BRACKEN, KAIJU
 *   cami-stats      python + polars/numpy/scipy/statsmodels AGGREGATE_COUNTS, BUILD_PAIRS, PAIRED_TEST
 *
 * WHY NOT ONE IMAGE PER TOOL, THE nf-core WAY
 *   HOST_REMOVAL is a single unbroken pipe: bwa-mem2 | samtools | keep_nonhost.sh
 *   | samtools | samtools. Nothing is written between the stages, so nothing can
 *   be split across containers. The grouping follows the pipes.
 *
 * WHY NOT UPSTREAM BioContainers
 *   The combinations this pipeline needs (bwa-mem2 WITH samtools WITH gawk) exist
 *   upstream only as mulled images whose tags are content hashes. A hash tells a
 *   reader nothing, and there is no such image at all for the statistics stack.
 *   The definitions in containers/ are readable, and they are versioned next to
 *   the code that depends on them.
 *
 * THE TAG IS SEPARATE FROM THE PIPELINE VERSION (params.container_tag).
 *   A documentation fix should not force five image rebuilds and a multi-gigabyte
 *   re-pull on every cluster running this. Bump container_tag when something in
 *   containers/ or env/requirements-stats.txt actually changes.
 *
 *   AND BUMP IT ON EVERY RELEASE TAG, even when no image content changed.
 *   .github/workflows/containers.yml builds on every `v*` tag and PUSHES using
 *   this value, so releasing a new version while this still holds the old one
 *   republishes the OLD image tag — moving an image that somebody's -resume is
 *   already keyed to, which is the exact failure containers exist to prevent.
 *   Rebuilds are not bit-identical, so "it is the same image anyway" is not true.
 *   The cost is one extra pull per release; the alternative is a tag that points
 *   at two different images over its life.
 *
 * NO CONTAINER ENGINE IS ENABLED BY DEFAULT. Everything here sits idle until you
 * pass -profile singularity (or apptainer/docker/podman). With -profile conda it
 * is ignored and conf/conda.config supplies the same software instead.
 * =============================================================================
 */

params {
    container_registry = 'ghcr.io/alihkz94'
    container_tag      = '1.0.0'

    // A directory of prebuilt .sif files, for a cluster with no route to a
    // registry. When set, it wins over container_registry and nothing is pulled:
    //     bash scripts/containers/pull_images.sh /shared/images   # where there IS a route
    //     nextflow run . -profile singularity --container_dir /shared/images
    //
    // The files must keep the names the pull script gives them,
    // cami-<group>-<tag>.sif, because that is what the mapping below builds.
    container_dir = null

    // Extra host paths to expose inside the container, comma separated. The data
    // root and the databases are handled automatically; add anything else your
    // site needs — most often the target of a symlink that lives outside both.
    container_binds = null
}

/*
 * EVERYTHING BELOW IS A CLOSURE, AND THAT IS THE WHOLE POINT.
 * -----------------------------------------------------------------------------
 * A process directive written as a closure is evaluated when the task is
 * submitted, not when the config is parsed. Written as a plain string it would be
 * frozen at parse time — before `--kraken_db` from the command line has been
 * applied, and before a site profile listed after the engine profile has had its
 * turn. Both are ordinary usage, and both would silently produce a container that
 * cannot see its own database.
 *
 * (The Nextflow 26 config parser also refuses a top-level `def`, so a shared
 * helper function is not available here in any case.)
 */

process {

    // --- which image ----------------------------------------------------------
    // Two forms, and the difference matters:
    //   registry form   ghcr.io/alihkz94/cami-align:1.0.0    pulled and converted
    //   local form      /shared/images/cami-align-1.0.0.sif  used as it is
    // An absolute path ending in .sif is handed straight to `singularity exec`;
    // anything else is treated as an image to pull. The local form therefore only
    // means anything under singularity/apptainer — Docker cannot run a .sif.
    withName: 'FETCH_GENOME|FETCH_UNMAPPED_BAM' {
        container = { params.container_dir ? "${params.container_dir}/cami-fetch-${params.container_tag}.sif"
                                           : "${params.container_registry}/cami-fetch:${params.container_tag}" }
    }
    withName: 'SUBSAMPLE_TRIM|DEDUP|AGGREGATE_QC' {
        container = { params.container_dir ? "${params.container_dir}/cami-qc-${params.container_tag}.sif"
                                           : "${params.container_registry}/cami-qc:${params.container_tag}" }
    }
    withName: 'BUILD_HOST_INDEX|BUILD_MM2_INDEX|HOST_REMOVAL|HUMAN_REMOVAL' {
        container = { params.container_dir ? "${params.container_dir}/cami-align-${params.container_tag}.sif"
                                           : "${params.container_registry}/cami-align:${params.container_tag}" }
    }
    withName: 'KRAKEN2_BRACKEN|KAIJU' {
        container = { params.container_dir ? "${params.container_dir}/cami-classify-${params.container_tag}.sif"
                                           : "${params.container_registry}/cami-classify:${params.container_tag}" }
    }
    withName: 'AGGREGATE_COUNTS|BUILD_PAIRS|PAIRED_TEST' {
        container = { params.container_dir ? "${params.container_dir}/cami-stats-${params.container_tag}.sif"
                                           : "${params.container_registry}/cami-stats:${params.container_tag}" }
    }

    /*
     * --- what the container can see ------------------------------------------
     * Nextflow mounts the work directory and every staged input by itself. It
     * cannot know about the two big databases, because those are passed to
     * Kraken 2 and Kaiju as PATH STRINGS and are deliberately never staged —
     * staging a 187 GB index into each task directory is not a thing anyone
     * should do.
     *
     * Only paths that EXIST are bound. Singularity refuses to start when told to
     * bind a directory that is not there, and on a first run the reference
     * directory has not been created yet — so an unconditional list would make
     * the REFERENCE step fail with an error about binds rather than about
     * references.
     *
     * `new File(...)`, not `file(...)`: the Nextflow 26 config parser does not
     * provide the latter.
     */
    containerOptions = {
        def wanted = [ params.dataRoot, params.kraken_db ]
        // .toString().toBoolean(): from the command line this is the string
        // "false", which is true in Groovy. See lib/helpers.nf.
        if( params.run_kaiju.toString().toBoolean() )
            wanted += [ params.kaiju_db, params.kaiju_nodes, params.kaiju_names ]
        if( params.container_binds )
            wanted += params.container_binds.toString().tokenize(',')*.trim()

        def dirs = wanted
            .findAll { p -> p && new File(p.toString()).exists() }
            // Bind the DIRECTORY. kraken_db is one already; kaiju_db is a file
            // inside one, and the .dmp taxonomy files sit beside it and are read
            // too, so binding the file alone would not be enough.
            .collect { p -> def f = new File(p.toString()); f.isDirectory() ? f.absolutePath : f.parentFile.absolutePath }
            .unique()

        // Nextflow tells us which engine actually won, so one rule covers all four.
        workflow.containerEngine in ['singularity', 'apptainer']
            ? dirs.collect { d -> "-B ${d}" }.join(' ')
            : dirs.collect { d -> "-v ${d}:${d}" }.join(' ')
    }
}
