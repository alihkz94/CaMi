/*
 * =============================================================================
 * conf/slurm.config — the generic Slurm executor
 * -----------------------------------------------------------------------------
 * Enabled by -profile slurm. It assumes the ordinary case: shared storage that
 * every node can see, and a scheduler that is free to place a task anywhere.
 *
 * Nothing here names a queue, a node or an account, because no two clusters
 * agree on those. Set them on the command line:
 *     nextflow run alihkz94/CaMi -profile singularity,slurm \
 *         --dataRoot /shared/cockle \
 *         -process.queue compute \
 *         -process.clusterOptions '--account=marine'
 * or, better, add a file under conf/site/ so nobody has to remember them again.
 *
 * IF YOUR DATA IS ON ONE NODE'S LOCAL DISK, this profile is not enough — a task
 * scheduled elsewhere cannot see the reads at all. conf/site/mpi_bremen.config
 * is a worked example of that case.
 * =============================================================================
 */

executor {
    name            = 'slurm'
    queueSize       = 20          // most tasks queued or running at one time
    submitRateLimit = '10/1min'   // be polite to the scheduler
    pollInterval    = '30 sec'
}

process {
    executor = 'slurm'

    /*
     * TMPDIR.
     *   Several steps here stream tens of gigabytes through temporary files —
     *   `samtools collate` above all. On a shared node the default /tmp is small,
     *   and filling it breaks the node for every other user, not just for you.
     *   Point it at the data root, which is sized for this work.
     *
     *   The conda_bin line is empty unless a site profile sets it. A Slurm child
     *   job does not inherit an activated conda environment from the head job, so
     *   a site that provisions software with neither a container nor -profile
     *   conda has to put it back on PATH by hand.
     */
    beforeScript = {
        def lines = []
        if( params.conda_bin ) lines << "export PATH=${params.conda_bin}:\$PATH"
        lines << "export TMPDIR=${params.tmpdir}"
        lines << "mkdir -p \"\$TMPDIR\""
        lines.join('\n')
    }
}
