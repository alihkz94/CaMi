/*
 * =============================================================================
 * conf/site/mpi_bremen.config — Max Planck Institute for Marine Microbiology
 * -----------------------------------------------------------------------------
 * The cluster the 563-sample run was produced on. Enabled with:
 *     nextflow run . -profile mpi_bremen -resume --step PROFILE
 *
 * KEEP THIS FILE AS A WORKED EXAMPLE even if you never use this cluster. It is
 * the awkward case that the generic slurm profile cannot cover, and the reasons
 * are the ones another site is most likely to hit too.
 *
 * THE AWKWARD PART: THE DATA IS ON ONE NODE'S LOCAL DISK
 *   About 4 TB of FASTQ sits on the local /scratch of slurm-406. It is not
 *   shared storage. Two things follow, and neither is optional:
 *
 *   1. Every task must be pinned to that node. A task placed anywhere else does
 *      not find a slow disk — it finds no file at all.
 *
 *   2. The same disk has two names. On slurm-406 it is /scratch/<user>/...; from
 *      the login node the very same bytes are /mnt/slurm-406/<user>/... . The
 *      Nextflow head process must therefore run ON the node, so that it and its
 *      tasks agree on the spelling. Two spellings would also split the -resume
 *      cache in half and repeat days of finished work. enforce_scratch makes
 *      lib/helpers.nf refuse to start from the wrong side.
 *
 * SOFTWARE
 *   This cluster has no Singularity, no Apptainer and no Docker — checked on
 *   both the login node and slurm-406. Software comes from a conda environment
 *   at conda_bin, and a Slurm child job does not inherit the head job's
 *   activation, so conf/slurm.config puts it back on PATH for every task.
 *
 *   That is why this file, and not the container profile, describes the run that
 *   produced the published results. If Singularity is ever installed here, drop
 *   conda_bin and stats_python and add -profile singularity: the container
 *   definitions in containers/ pin the same versions this environment holds.
 * =============================================================================
 */

includeConfig '../slurm.config'

params {
    dataRoot     = '/scratch/ahakimzadeh/Alicia_nature_data'
    kraken_db    = '/scratch/ahakimzadeh/Alicia_nature_data/kraken2_db/standard_16gb_20250402'

    kaiju_db     = '/slurm-databases/Kaiju/kaiju_db_nr_euk.fmi'
    kaiju_nodes  = '/slurm-databases/Kaiju/nodes.dmp'
    kaiju_names  = '/slurm-databases/Kaiju/names.dmp'

    vibrio_fa    = '/scratch/ahakimzadeh/Alicia_nature_data/alicia_bundle/reference/validation/vibrio_panel.fa.gz'

    // The data is on the LOCAL disk of this node, so every task must land there.
    cluster_node    = 'slurm-406'
    enforce_scratch = true

    // No container engine on this cluster — see the header.
    conda_bin    = '/home/ahakimzadeh/miniforge3/envs/cancer/bin'
    // The statistics stack is a venv built from env/requirements-stats.txt,
    // deliberately separate from the conda env: installing numpy and scipy into
    // the env that bwa-mem2, Kraken 2 and Kaiju are running from could disturb a
    // 563-sample run in progress. A venv is a separate prefix and cannot.
    //   Create it once:  bash scripts/analysis/setup_stats_env.sh
    stats_python = '/scratch/ahakimzadeh/Alicia_nature_data/envs/stats/bin/python'

    slurm_queue  = 'slurm'
}

process {
    queue = 'slurm'
    // Pin every task to the node that physically holds the data.
    clusterOptions = params.cluster_node ? "--nodelist=${params.cluster_node}" : ''

    // Refuse to start if TMPDIR is not on /scratch. This is not decoration:
    // filling /tmp on a shared node breaks the node for every user, and the site
    // administrators have warned about it.
    beforeScript = {
        """
        export PATH=${params.conda_bin}:\$PATH
        export TMPDIR=${params.tmpdir}
        case "\$TMPDIR" in /scratch/*) ;; *) echo "TMPDIR not on /scratch: \$TMPDIR" >&2; exit 1;; esac
        mkdir -p "\$TMPDIR"
        """.stripIndent()
    }
}
