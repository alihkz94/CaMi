/*
 * =============================================================================
 * conf/conda.config — the same software, without a container engine
 * -----------------------------------------------------------------------------
 * Enabled by -profile conda. Use it when the machine has no Singularity, no
 * Apptainer and no Docker — which is common on a shared workstation, and on the
 * few clusters that still forbid user namespaces.
 *
 * THIS IS THE SECOND-BEST OPTION AND THE README SAYS SO.
 *   A conda solve is reproducible in intent, not in fact: it re-resolves the
 *   transitive dependency graph at install time, so the compiler runtime, the
 *   zlib, and the glibc a tool ends up linked against depend on when and where
 *   you ran it. An image is the same bytes on every machine and in five years.
 *   Use -profile singularity for anything whose numbers will be published.
 *
 * The environment files are the SAME ones the images are built from
 * (containers/<group>/environment.yml), so the two paths cannot describe
 * different software. The one exception is the statistics stack, and
 * env/stats-conda.yml explains itself.
 * =============================================================================
 */

conda {
    enabled     = true
    useMicromamba = true    // faster and stricter than the classic solver
    // A solve can take minutes on a large channel set, and the default 20 min
    // timeout expires on a slow or proxied network before conda has finished.
    createTimeout = '2 h'
}

process {
    withName: 'FETCH_GENOME|FETCH_UNMAPPED_BAM' {
        conda = "${projectDir}/containers/fetch/environment.yml"
    }
    withName: 'SUBSAMPLE_TRIM|DEDUP|AGGREGATE_QC' {
        conda = "${projectDir}/containers/qc/environment.yml"
    }
    withName: 'BUILD_HOST_INDEX|BUILD_MM2_INDEX|HOST_REMOVAL|HUMAN_REMOVAL' {
        conda = "${projectDir}/containers/align/environment.yml"
    }
    withName: 'KRAKEN2_BRACKEN|KAIJU' {
        conda = "${projectDir}/containers/classify/environment.yml"
    }
    withName: 'AGGREGATE_COUNTS|BUILD_PAIRS|PAIRED_TEST' {
        conda = "${projectDir}/env/stats-conda.yml"
    }
}
