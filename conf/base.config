/*
 * conf/base.config — resource requests for each process
 * -----------------------------------------------------------------------------
 * Read results/pipeline_info/trace.txt after a run and correct these numbers.
 * The columns peak_rss and realtime tell you what each task really used.
 */

process {

    cpus   = 4
    memory = 8.GB
    time   = '4h'

    // Retry on out-of-memory, node failure, or timeout, and give more memory each
    // attempt. The default is 'finish': a setup fault (a missing index, a bad
    // database path) is real, and it must stop the run rather than repeat 498 times.
    errorStrategy = { task.exitStatus in [104,125,134,137,139,140,143,247] && task.attempt <= 3 ? 'retry' : 'finish' }
    maxRetries    = 3

    // Size and path caching, not timestamps. Multi-GB inputs get touched by rsync
    // and by the download array; strict mode would break -resume for no reason.
    cache = 'lenient'

    // --- reference preparation ------------------------------------------------
    withName: FETCH_GENOME     { cpus = 4;  memory = 8.GB;                     time = '4h' }
    withName: BUILD_HOST_INDEX { cpus = 8;  memory = { 64.GB * task.attempt }; time = '6h' }
    withName: BUILD_MM2_INDEX  { cpus = 16; memory = { 48.GB * task.attempt }; time = '4h' }

    // --- BAM-only runs --------------------------------------------------------
    // ENA limits the number of connections for each client, and the 498-run
    // download array already uses them. One fetch at a time.
    // The time is high because the task waits out proxy outages itself
    // (5 + 10 + 15 minutes). 'ignore' so that one unavailable BAM cannot stop
    // the other 64.
    withName: FETCH_UNMAPPED_BAM {
        cpus = 4; memory = 8.GB; time = '12h'; maxForks = 1
        errorStrategy = { task.attempt <= 2 ? 'retry' : 'ignore' }
        maxRetries    = 2
    }

    // --- analysis -------------------------------------------------------------
    withName: SUBSAMPLE_TRIM { cpus = 8;  memory = { 16.GB * task.attempt }; time = { 8.h  * task.attempt } }
    withName: HOST_REMOVAL   { cpus = 16; memory = { 48.GB * task.attempt }; time = { 12.h * task.attempt } }
    withName: HUMAN_REMOVAL  { cpus = 16; memory = { 48.GB * task.attempt }; time = { 12.h * task.attempt } }
    withName: DEDUP          { cpus = 8;  memory = { 16.GB * task.attempt }; time = '6h' }

    // Kraken 2 memory-maps its database, so concurrent tasks share one copy in the
    // page cache. Slurm still charges the mapped pages to each task, hence the cap.
    // BOTH numbers follow the database and must be raised together with it:
    //   standard-16 (16 GB) -> kraken_mem_gb 32,  kraken_forks 8
    //   PlusPF      (94 GB) -> kraken_mem_gb 130, kraken_forks 4
    withName: KRAKEN2_BRACKEN {
        cpus     = 16
        memory   = { "${params.kraken_mem_gb + 16 * (task.attempt - 1)} GB" }
        time     = { 8.h * task.attempt }
        maxForks = params.kraken_forks
    }

    // Kaiju LOADS its index into memory — it does not memory-map it like Kraken 2.
    // Each concurrent task therefore needs its own ~187 GB. slurm-406 has 4.1 TB,
    // but other groups use it too, so keep kaiju_forks small.
    // MEASURED 2026-08-15 on two samples: peak_rss 190.6 and 193.7 GB, 3m24s and
    // 3m33s at test depth. The index alone is ~187 GB, so memory barely moves with
    // read count — but the margin over 193.7 GB must be real, and a retry MUST ask
    // for more. Without the task.attempt term an OOM would retry at the same size,
    // fail three times, and silently drop the sample from the Kaiju results.
    withName: KAIJU {
        cpus     = 16
        memory   = { "${params.kaiju_mem_gb + 30 * (task.attempt - 1)} GB" }
        time     = { 12.h * task.attempt }
        maxForks = params.kaiju_forks
    }

    withName: AGGREGATE_QC { cpus = 2; memory = 8.GB; time = '2h' }

    // --- confirmation (--run_confirm) -----------------------------------------
    // CONFIRM_KRAKEN shares the memory-mapped database with KRAKEN2_BRACKEN, so it
    // follows the same two numbers. CONFIRM_BLAST scans nt once per chunk; keep
    // blast_forks small so concurrent scans do not saturate the file system.
    withName: CONFIRM_KRAKEN {
        cpus     = 8
        memory   = { "${params.kraken_mem_gb + 16 * (task.attempt - 1)} GB" }
        time     = { 4.h * task.attempt }
        maxForks = params.kraken_forks
    }
    withName: CONFIRM_DRAW       { cpus = 1; memory = { 8.GB * task.attempt }; time = '4h' }
    withName: CONFIRM_BLAST_PREP { cpus = 1; memory = { 8.GB * task.attempt }; time = '2h' }
    withName: CONFIRM_BLAST {
        cpus     = 12
        memory   = { "${params.blast_mem_gb + 16 * (task.attempt - 1)} GB" }
        time     = { 24.h * task.attempt }
        maxForks = params.blast_forks
    }
    withName: CONFIRM_COMBINE    { cpus = 8; memory = { 32.GB * task.attempt }; time = '8h' }

    // --- downstream statistics (--step STATS) ---------------------------------
    // Small, single-threaded work on tables, not on reads. AGGREGATE_COUNTS gets
    // the most memory because it holds the full long-format count table.
    // These do NOT get the 'ignore' strategy below: unlike a per-sample task,
    // a failure here means the WHOLE analysis produced nothing, so it must stop
    // loudly rather than leave an empty directory that looks like a result.
    withName: AGGREGATE_COUNTS { cpus = 2; memory = { 24.GB * task.attempt }; time = '4h' }
    withName: BUILD_PAIRS      { cpus = 1; memory = 8.GB;                     time = '1h' }
    withName: PAIRED_TEST      { cpus = 2; memory = { 16.GB * task.attempt }; time = '4h' }

    // Per-sample analysis: retry 3 times, then drop THAT sample and carry on.
    // With 'finish', one unreadable FASTQ out of 498 would end the whole run.
    // Dropped samples appear in the Nextflow summary and in trace.txt, and they are
    // absent from qc_report.tsv — so nothing is lost silently.
    // CONFIRM_KRAKEN and CONFIRM_DRAW are per sample too. A sample they drop is
    // listed in 12_confirmation/confirm_incomplete.txt.
    withName: 'SUBSAMPLE_TRIM|HOST_REMOVAL|HUMAN_REMOVAL|DEDUP|KRAKEN2_BRACKEN|KAIJU|CONFIRM_KRAKEN|CONFIRM_DRAW' {
        // 'ignore' is for a task that RAN and failed: drop that one sample and keep
        // the rest of the cohort. It must not apply to a task that never ran at all.
        // A submission rejected by the scheduler has no exit status, and treating
        // that as ignorable discards work the data was never responsible for — the
        // processes downstream then wait forever on inputs that cannot arrive, and
        // the run deadlocks while still holding its allocation.
        errorStrategy = {
            def neverRan = task.exitStatus == null || task.exitStatus == Integer.MAX_VALUE
            ( neverRan || task.exitStatus in [104,125,134,137,139,140,143,247] ) && task.attempt <= 3
                ? 'retry' : 'ignore'
        }
    }
}

/*
 * Retrying a failed SUBMISSION, which is not the same thing as a failed task.
 * The job never reached a node, so nothing about the data is in question and the
 * only sensible response is to ask again.
 *
 * Nextflow already does this, but `reason` defaults to matching only
 * "Socket timed out". A scheduler that refuses with any other wording — an
 * unreachable controller, a rejected batch submission — falls straight through
 * to the per-process errorStrategy above. The pattern below covers the common
 * transient failures for Slurm, SGE and LSF.
 *
 * Grid executors only; ignored under -profile local.
 */
executor {
    retry {
        maxAttempts = 5
        delay       = '30s'
        maxDelay    = '10min'
        jitter      = 0.25
        reason      = '.*(Socket timed out|Unable to contact slurm controller|Batch job submission failed|Connection timed out|Transport endpoint|error: Unable to run job|Failed to submit).*'
    }
}
